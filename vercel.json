{
  "version": 2,
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/venezuela.svg", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/styles.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }] },
    { "source": "/app.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }] }
  ],
  "rewrites": [
    { "source": "/api/exportar.csv",  "destination": "/api/exportar?formato=csv" },
    { "source": "/api/exportar.json", "destination": "/api/exportar?formato=json" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
